<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ISpy.ViewModels"
             x:Class="ISpy.Views.GamePage"
             x:DataType="vm:GameViewModel"
             BackgroundColor="{StaticResource Cream}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="12" RowSpacing="10">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout Grid.Column="0" Spacing="0">
                <Label Text="I Spy" FontSize="30" FontAttributes="Bold"
                       TextColor="{StaticResource Ink}" />
                <Label Text="{Binding StatusText}" FontSize="14"
                       TextColor="{StaticResource InkSoft}" />
            </VerticalStackLayout>

            <Border Grid.Column="1" Stroke="{StaticResource Accent}"
                    StrokeThickness="2" BackgroundColor="{StaticResource AccentSoft}"
                    Padding="14,6" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Label Text="{Binding ProgressText}" FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource Accent}" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Scene -->
        <Border Grid.Row="1" Stroke="{StaticResource InkSoft}" StrokeThickness="2"
                BackgroundColor="{StaticResource Paper}" Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <AbsoluteLayout x:Name="SceneLayout"
                            SizeChanged="OnSceneSizeChanged" />
        </Border>

        <!-- Checklist -->
        <ScrollView Grid.Row="2" Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="ChecklistLayout" Spacing="10" Padding="2"
                                   BindableLayout.ItemsSource="{Binding Checklist}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChecklistItemViewModel">
                        <Border WidthRequest="104" HeightRequest="128"
                                Stroke="{StaticResource InkSoft}" StrokeThickness="2"
                                BackgroundColor="{StaticResource Paper}" Padding="8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Grid RowDefinitions="*,Auto,Auto" RowSpacing="4">
                                <Image Grid.Row="0" Source="{Binding ImageFile}"
                                       Aspect="AspectFit" />
                                <Label Grid.Row="1" Text="{Binding Name}"
                                       FontSize="13" HorizontalTextAlignment="Center"
                                       TextColor="{StaticResource Ink}" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="2" Text="{Binding StatusGlyph}"
                                       FontSize="20" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{StaticResource Accent}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- New round -->
        <Button Grid.Row="3" Text="New Round" Command="{Binding NewRoundCommand}"
                BackgroundColor="{StaticResource Accent}" TextColor="White"
                FontSize="18" FontAttributes="Bold" CornerRadius="16" HeightRequest="52" />
    </Grid>
</ContentPage>
